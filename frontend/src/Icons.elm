module Icons exposing (Icon(..), view)

{-| Ícones do álbum: Phosphor Icons 2.1.1, peso bold (licença MIT).

Cada ícone herda `currentColor` e fica sempre ao lado de um texto, exceto o
botão de tema, que leva `aria-label`.

-}

import Html exposing (Html)
import Html.Attributes exposing (attribute)
import Svg exposing (path, svg)
import Svg.Attributes exposing (class, d, viewBox)


type Icon
    = Dica
    | Resolver
    | Reiniciar
    | Lua
    | Sol
    | X
    | Alerta
    | SemRede


{-| Desenha o ícone com a classe CSS dada (`icon` ou `mark-x`).
-}
view : String -> Icon -> Html msg
view className icon =
    svg
        [ class className
        , viewBox "0 0 256 256"
        , attribute "aria-hidden" "true"
        , attribute "focusable" "false"
        ]
        [ path [ d (pathData icon) ] [] ]


